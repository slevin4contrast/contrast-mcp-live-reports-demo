{
  "name": "contrast-generated-reports",
  "version": "1.0.0",
  "private": true,
  "description": "Security reports generated from the Contrast MCP server, served live by a local proxy",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "mock": "MOCK=1 node server.js",
    "setup": "node scripts/register-client.js",
    "login": "node scripts/login.js",
    "test": "node test/unit.js && node test/smoke.js",
    "fixtures": "node scripts/fixtures.js",
    "snapshot": "node scripts/snapshot.js",
    "test:unit": "node test/unit.js",
    "test:scale": "node test/scale.js"
  },
  "engines": {
    "node": ">=18"
  }
}